# Reference only. The app reads process environment variables, not this file.
# Put the real values in Render > Environment; never commit an actual .env file.
CATALOG_PROVIDER=cloudflare
CATALOG_CHAT_ENABLED=false
CATALOG_CLOUD_LIMITS_CONFIRMED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=celehs-data
CLOUDFLARE_API_TOKEN=
# Render supplies RENDER_EXTERNAL_HOSTNAME. For an optional custom domain:
# CATALOG_PUBLIC_ORIGIN=https://your-domain.example
